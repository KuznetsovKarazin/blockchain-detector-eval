{
  "schema": "security_resource_profile_config_v1",
  "purpose": "resource_only_development_no_accuracy_evaluation",
  "pilot_run": "papers/security_evaluation/runs/dev_fixed_t_20261025_v1",
  "class": "reentrancy",
  "seed": 0,
  "training_regime": "joint_project_clone_disjoint",
  "test_role": "common_test_source_only",
  "methods": [
    "raw_tfidf_lr",
    "normalized_tfidf_lr",
    "pattern_rf",
    "pattern_lightgbm"
  ],
  "tuning_budget": 0,
  "test_labels_read": false,
  "external_files_used": false,
  "prediction_persistence": "discard_after_shape_and_finiteness_check",
  "tfidf": {
    "token_pattern": "\\S+",
    "ngram_range": [
      1,
      3
    ],
    "min_df": 2,
    "max_features": 50000,
    "sublinear_tf": true,
    "lowercase": false
  },
  "lr_scaler": {
    "class": "StandardScaler",
    "with_mean": false
  },
  "lr": {
    "C": 1.0,
    "max_iter": 3000,
    "class_weight": "balanced",
    "random_state": 0,
    "solver": "lbfgs",
    "tol": 0.0001
  },
  "rf": {
    "n_estimators": 500,
    "class_weight": "balanced_subsample",
    "min_samples_leaf": 1,
    "n_jobs": 4,
    "random_state": 0
  },
  "lightgbm": {
    "n_estimators": 400,
    "learning_rate": 0.05,
    "num_leaves": 31,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "class_weight": "balanced",
    "random_state": 0,
    "verbose": -1,
    "n_jobs": 4
  },
  "threads": {
    "lr_native_pools": 1,
    "tree_jobs": 4,
    "tree_blas_threads": 1
  },
  "ram_metric": "Linux process ru_maxrss MiB, cumulative high-water mark across sequential methods",
  "projection": {
    "regimes": 4,
    "classes": 2,
    "paired_sampling_seeds": 5,
    "evaluations_per_method": 40,
    "total_fits": 160,
    "scope": "one fixed T and one training-size point; sequential no feature-cache reuse",
    "excluded": [
      "data retrieval and audit",
      "expert review",
      "Slither",
      "bootstrap",
      "additional tests or learning-curve sizes",
      "hyperparameter tuning"
    ]
  },
  "timing_scope": "preprocessing/fit/predict measured separately; imports, validation and source I/O reported as setup"
}
